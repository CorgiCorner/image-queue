{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-queue",
  "main": "cloudflare-worker.ts",
  "triggers": { "crons": ["0 * * * *"] },
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "IMAGE_QUEUE_STORAGE_DRIVER": "cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "image-queue",
      "database_id": "local-image-queue"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "image-queue"
    }
  ],
  "queues": {
    "producers": [{ "binding": "GENERATION_QUEUE", "queue": "image-queue-generation" }],
    "consumers": [{
      "queue": "image-queue-generation",
      "max_batch_size": 1,
      "max_batch_timeout": 0,
      "max_retries": 0,
      "max_concurrency": 20
    }]
  },
  "images": {
    "binding": "IMAGES"
  }
}
