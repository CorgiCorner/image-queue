IMAGE_QUEUE_STORAGE_DRIVER=fs
IMAGE_QUEUE_STORAGE_DIR=./storage
IMAGE_QUEUE_QUEUE_DIR=./image-queue
# Server-only encryption secret for existing encrypted credential records.
IMAGE_QUEUE_SETTINGS_SECRET=
IMAGE_QUEUE_MCP_TOKEN=
IMAGE_QUEUE_CF_ACCESS_TEAM_DOMAIN=
IMAGE_QUEUE_CF_ACCESS_AUDIENCE=
IMAGE_QUEUE_ACCESS_ALLOWED_EMAILS=
# Platform path separator between allowed reference directories.
IMAGE_QUEUE_REFERENCE_ROOTS=
IMAGE_QUEUE_OPENAI_API_KEY=
IMAGE_QUEUE_GOOGLE_GENERATIVE_AI_API_KEY=
IMAGE_QUEUE_OPENROUTER_API_KEY=
IMAGE_QUEUE_AI_GATEWAY_API_KEY=

# Dashboard address opened by MCP image cards
IMAGE_QUEUE_DASHBOARD_URL=http://127.0.0.1:3215

# Local Codex execution is default and starts paused in Settings.
# Advanced scheduled-chat compatibility only:
# IMAGE_QUEUE_EXECUTOR=scheduled
# Optional stable installed executable path; otherwise resolved from PATH.
# IMAGE_QUEUE_CODEX_BIN=codex
