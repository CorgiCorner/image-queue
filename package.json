{
  "name": "image-queue",
  "version": "0.1.0",
  "description": "Local-first image queue and generation workspace",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3215",
    "build": "pnpm check:boundaries && pnpm build:mcp-views && next build",
    "start": "next start --hostname 127.0.0.1 --port 3215",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mcp": "node --env-file-if-exists=.env.local --import tsx src/mcp/stdio.ts",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "pool": "node --env-file-if-exists=.env.local --import tsx scripts/pool.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "build:mcp": "pnpm check:boundaries && pnpm build:mcp-views && esbuild src/mcp/stdio.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/mcp.mjs",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "build:mcp-views": "tsx scripts/build-mcp-views.ts"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@ai-sdk/gateway": "4.0.146",
    "@ai-sdk/google": "4.0.121",
    "@ai-sdk/openai": "4.0.118",
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@opennextjs/cloudflare": "1.20.17",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "ai": "7.0.173",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fs-native-extensions": "1.5.3",
    "image-size": "2.1.0",
    "jose": "6.2.17",
    "morphicons": "^2.0.2",
    "next": "16.4.6",
    "next-safe-action": "8.7.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "image-queue": "dist/mcp.mjs"
  }
}
